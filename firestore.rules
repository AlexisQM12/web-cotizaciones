rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: only authenticated users
    function isAuth() {
      return request.auth != null;
    }

    // Helper: get user's empresaId
    function getUserEmpresaId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empresaId;
    }

    // Helper: Is SuperAdmin
    function isSuperAdmin() {
      return isAuth() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // admins
    match /admins/{email} {
      allow read: if isAuth() && request.auth.token.email.lower() == email;
      allow read, write: if isSuperAdmin();
    }

    // tenant_users (Whitelist for Tenant Admins)
    match /tenant_users/{email} {
      allow read: if isSuperAdmin() || (isAuth() && request.auth.token.email.lower() == email);
      allow write: if isSuperAdmin();
    }
    
    // allowedTechnicians
    match /allowedTechnicians/{email} {
      allow read: if true;
    }

    // Helper: verify if the request matches the user's empresaId
    function isUserInEmpresa(empresaId) {
      return isAuth() && getUserEmpresaId() == empresaId;
    }

    // Quotations: authenticated users can only access quotations for their empresaId
    match /quotations/{quotationId} {
      allow read: if isAuth() && resource.data.empresaId == getUserEmpresaId();
      allow create: if isAuth() && request.resource.data.empresaId == getUserEmpresaId();
      allow update, delete: if isAuth() && resource.data.empresaId == getUserEmpresaId();

      // ActiveUsers subcollection: authenticated users can read/write their own doc
      match /activeUsers/{userId} {
        allow read: if isAuth();
        allow write: if isAuth() && request.auth.uid == userId;
        allow delete: if isAuth() && request.auth.uid == userId;
      }
    }

    // Company profiles
    match /company_profiles/{profileId} {
      // The profileId is essentially the empresaId for the main tenant architecture
      allow read, update, delete: if isAuth() && getUserEmpresaId() == profileId;
      // Anyone authenticated can create a company (happens during onboarding)
      allow create: if isAuth();
    }

    // Client profiles
    match /client_profiles/{profileId} {
      allow read: if isAuth() && resource.data.empresaId == getUserEmpresaId();
      allow create: if isAuth() && request.resource.data.empresaId == getUserEmpresaId();
      allow update, delete: if isAuth() && resource.data.empresaId == getUserEmpresaId();
    }

    // Settings (general conditions, etc.)
    match /settings/{docId} {
      allow read, write: if isAuth(); // Used for general settings, though mostly unused now
    }
    
    // Accounting config
    match /accounting_config/{configId} {
      allow read, update, delete: if isAuth() && getUserEmpresaId() == configId;
      allow create: if isAuth();
    }

    // Scanner state
    match /scanner_state/{docId} {
      allow read: if isAuth();
    }

    // ── Multi-tenant SaaS (modelo actual): datos bajo tenants/{empresaId}/cgo_* ──
    // Permite a los miembros de una empresa leer/escribir los datos de SU tenant.
    // Es path-based (depende de tenantId del path, no de resource.data), por lo que
    // habilita también las consultas de lista (onSnapshot) que usa el dashboard.
    match /tenants/{tenantId} {
      allow read, write: if isUserInEmpresa(tenantId) || isSuperAdmin();
      match /{document=**} {
        allow read, write: if isUserInEmpresa(tenantId) || isSuperAdmin();
      }
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth() || isSuperAdmin();
      allow write: if (isAuth() && request.auth.uid == userId) || isSuperAdmin();
    }
  }
}

